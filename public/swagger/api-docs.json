{
  "openapi": "3.0.3",
  "info": {
    "title": "webAwanna Mobile API",
    "description": "API mobile untuk aplikasi webAwanna — mengelola transaksi keuangan (bank_transfers).\n\n## Autentikasi\nSemua endpoint dilindungi oleh **Bearer Token** yang di-hash (SHA-256) dan dicocokkan dengan `mobile_devices.token_hash` di database.\n\nToken diperoleh dari halaman **Mobile Devices** di panel admin (`/mobile-devices`). Token hanya ditampilkan **SEKALI** saat pembuatan atau regenerate.\n\n### Cara Penggunaan\nSertakan header `Authorization` pada setiap request:\n```\nAuthorization: Bearer ak_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx\n```\n\n### Isolasi Akun\nSetiap device terikat pada **satu akun** (`accounts`). Data yang dikembalikan hanya milik akun tersebut — tidak ada akses silang antar akun.",
    "version": "1.0.0",
    "contact": {
      "name": "webAwanna Team"
    }
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8000/api",
      "description": "Local Development"
    },
    {
      "url": "https://your-domain.com/api",
      "description": "Production"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "API Key",
        "description": "Token plain-text dari halaman Mobile Devices (format: ak_live_ + 32 karakter). Token di-hash SHA-256 di server untuk pencocokan."
      }
    },
    "schemas": {
      "Transaction": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "ID unik transaksi",
            "example": 42
          },
          "amount": {
            "type": "string",
            "description": "Jumlah nominal transaksi (Rp)",
            "example": "183000.00"
          },
          "user_name": {
            "type": "string",
            "description": "Nama pengguna yang membuat transaksi",
            "example": "Rina CS"
          },
          "transaction_date": {
            "type": "string",
            "description": "Tanggal transaksi (format: Y-m-d H:i)",
            "example": "2026-08-26 14:30"
          },
          "description": {
            "type": "string",
            "nullable": true,
            "description": "Keterangan / template chat konfirmasi pesanan",
            "example": "Pesanan Kacamata Multifokus untuk Budi"
          },
          "product_name": {
            "type": "string",
            "description": "Nama produk terkait",
            "example": "Kacamata Multifokus"
          },
          "image_url": {
            "type": "string",
            "nullable": true,
            "description": "URL endpoint untuk mengambil gambar bukti transfer (WebP). Null jika tidak ada gambar.",
            "example": "http://127.0.0.1:8000/api/mobile/transactions/42/image"
          },
          "status": {
            "type": "string",
            "enum": ["pending", "confirmed", "approved", "rejected"],
            "description": "Status transaksi",
            "example": "pending"
          }
        }
      },
      "TransactionListResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "success"
          },
          "datas": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Transaction"
            }
          },
          "meta": {
            "type": "object",
            "properties": {
              "current_page": {
                "type": "integer",
                "example": 1
              },
              "last_page": {
                "type": "integer",
                "example": 5
              },
              "per_page": {
                "type": "integer",
                "example": 15
              },
              "total": {
                "type": "integer",
                "example": 72
              }
            }
          }
        }
      },
      "TransactionDetailResponse": {
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/Transaction"
          }
        }
      },
      "ConfirmResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "example": "Transaksi berhasil dikonfirmasi."
          },
          "data": {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer",
                "example": 42
              },
              "status": {
                "type": "string",
                "example": "confirmed"
              },
              "category": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "integer",
                    "example": 3
                  },
                  "name": {
                    "type": "string",
                    "example": "Bank Transfer"
                  },
                  "type": {
                    "type": "string",
                    "example": "in"
                  }
                }
              }
            }
          }
        }
      },
      "RejectResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "example": "Transaksi berhasil ditolak."
          },
          "data": {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer",
                "example": 42
              },
              "status": {
                "type": "string",
                "example": "rejected"
              },
              "rejection_note": {
                "type": "string",
                "example": "Nominal tidak sesuai dengan bukti"
              }
            }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "example": "Token tidak ditemukan."
          }
        }
      },
      "ValidationErrorResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "example": "Transaksi tidak bisa dikonfirmasi."
          },
          "current_status": {
            "type": "string",
            "example": "approved"
          }
        }
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "Token tidak ditemukan atau tidak valid",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "examples": {
              "no_token": {
                "summary": "Token tidak dikirim",
                "value": {
                  "message": "Token tidak ditemukan."
                }
              },
              "invalid_token": {
                "summary": "Token tidak valid atau device dicabut",
                "value": {
                  "message": "Token tidak valid atau device sudah dicabut."
                }
              }
            }
          }
        }
      },
      "NotFound": {
        "description": "Data tidak ditemukan",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "message": "Transaksi tidak ditemukan atau bukan milik akun ini."
            }
          }
        }
      }
    }
  },
  "paths": {
    "/mobile/transactions": {
      "get": {
        "tags": ["Transactions"],
        "summary": "Daftar transaksi",
        "description": "Mengambil daftar transaksi milik akun yang terkait dengan device ini. Data diurutkan berdasarkan tanggal transaksi terbaru (descending). Mendukung pagination.",
        "operationId": "listTransactions",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Nomor halaman (default: 1)",
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "required": false,
            "description": "Jumlah item per halaman (default: 15)",
            "schema": {
              "type": "integer",
              "default": 15
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Berhasil - daftar transaksi",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TransactionListResponse"
                },
                "example": {
                  "status": "success",
                  "datas": [
                    {
                      "id": 42,
                      "amount": "183000.00",
                      "user_name": "Rina CS",
                      "transaction_date": "2026-08-26 14:30",
                      "description": "Pesanan Kacamata Multifokus untuk Budi",
                      "product_name": "Kacamata Multifokus",
                      "image_url": "http://127.0.0.1:8000/api/mobile/transactions/42/image",
                      "status": "pending"
                    },
                    {
                      "id": 41,
                      "amount": "95000.00",
                      "user_name": "Andi CS",
                      "transaction_date": "2026-08-26 10:15",
                      "description": null,
                      "product_name": "-",
                      "image_url": null,
                      "status": "approved"
                    }
                  ],
                  "meta": {
                    "current_page": 1,
                    "last_page": 5,
                    "per_page": 15,
                    "total": 72
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/mobile/transactions/{id}": {
      "get": {
        "tags": ["Transactions"],
        "summary": "Detail transaksi",
        "description": "Mengambil detail satu transaksi berdasarkan ID. Transaksi harus milik akun device ini.",
        "operationId": "getTransaction",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "ID transaksi",
            "schema": {
              "type": "integer"
            },
            "example": 42
          }
        ],
        "responses": {
          "200": {
            "description": "Berhasil - detail transaksi",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TransactionDetailResponse"
                },
                "example": {
                  "data": {
                    "id": 42,
                    "amount": "183000.00",
                    "user_name": "Rina CS",
                    "transaction_date": "2026-08-26 14:30",
                    "description": "Pesanan Kacamata Multifokus untuk Budi",
                    "product_name": "Kacamata Multifokus",
                    "image_url": "http://127.0.0.1:8000/api/mobile/transactions/42/image",
                    "status": "pending"
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/mobile/transactions/{id}/image": {
      "get": {
        "tags": ["Transactions"],
        "summary": "Ambil gambar bukti transfer",
        "description": "Mengambil file gambar bukti transfer milik transaksi tertentu. Prioritas format: WebP lalu original (JPG/PNG). Gambar disimpan di storage private.",
        "operationId": "getTransactionImage",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "ID transaksi",
            "schema": {
              "type": "integer"
            },
            "example": 42
          }
        ],
        "responses": {
          "200": {
            "description": "Berhasil - file gambar",
            "content": {
              "image/webp": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "image/jpeg": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "image/png": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "description": "Transaksi tidak ditemukan atau tidak memiliki gambar"
          }
        }
      }
    },
    "/mobile/transactions/{id}/confirm": {
      "post": {
        "tags": ["Transactions"],
        "summary": "Konfirmasi transaksi",
        "description": "Mengubah status transaksi dari pending ke confirmed. Alur: pending → confirmed → approved (oleh keuangan/owner). Hanya transaksi berstatus pending yang bisa dikonfirmasi.",
        "operationId": "confirmTransaction",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "ID transaksi",
            "schema": {
              "type": "integer"
            },
            "example": 42
          }
        ],
        "responses": {
          "200": {
            "description": "Berhasil - transaksi dikonfirmasi",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConfirmResponse"
                },
                "example": {
                  "message": "Transaksi berhasil dikonfirmasi.",
                  "data": {
                    "id": 42,
                    "status": "confirmed",
                    "category": {
                      "id": 3,
                      "name": "Bank Transfer",
                      "type": "in"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "422": {
            "description": "Transaksi tidak bisa dikonfirmasi (bukan status pending)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorResponse"
                },
                "example": {
                  "message": "Transaksi tidak bisa dikonfirmasi.",
                  "current_status": "approved"
                }
              }
            }
          }
        }
      }
    },
    "/mobile/transactions/{id}/reject": {
      "post": {
        "tags": ["Transactions"],
        "summary": "Tolak transaksi",
        "description": "Menolak transaksi dengan alasan (rejection_note). Hanya transaksi berstatus pending atau confirmed yang bisa ditolak.",
        "operationId": "rejectTransaction",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "ID transaksi",
            "schema": {
              "type": "integer"
            },
            "example": 42
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["rejection_note"],
                "properties": {
                  "rejection_note": {
                    "type": "string",
                    "maxLength": 500,
                    "description": "Alasan penolakan",
                    "example": "Nominal tidak sesuai dengan bukti, silakan cek ulang"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Berhasil - transaksi ditolak",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RejectResponse"
                },
                "example": {
                  "message": "Transaksi berhasil ditolak.",
                  "data": {
                    "id": 42,
                    "status": "rejected",
                    "rejection_note": "Nominal tidak sesuai dengan bukti, silakan cek ulang"
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "422": {
            "description": "Transaksi tidak bisa ditolak (sudah approved/ditolak)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorResponse"
                },
                "example": {
                  "message": "Transaksi tidak bisa ditolak.",
                  "current_status": "approved"
                }
              }
            }
          }
        }
      }
    }
  }
}
